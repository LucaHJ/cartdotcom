{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartdotcom-nba-curiosities",
  "main": "worker.js",
  "compatibility_date": "2026-09-06",
  "account_id": "59effd14cb12e91e3486304a934e395d",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "cartdotcom.com/backend/nba", "zone_name": "cartdotcom.com" },
    { "pattern": "cartdotcom.com/backend/nba/*", "zone_name": "cartdotcom.com" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
