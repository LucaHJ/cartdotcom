{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cartdotcom-news-snapshot-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "NEWS_DB",
      "database_name": "cartdotcom-news-dashboard-snapshot-test",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTICLE_CORPUS",
      "bucket_name": "cartdotcom-news-dashboard-snapshot-test"
    }
  ]
}
