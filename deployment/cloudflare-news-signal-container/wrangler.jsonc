{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cartdotcom-news-signal-container",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "CODEX_RESEARCH_MODEL": "gpt-5.6-luna",
    "CODEX_RESEARCH_REASONING_EFFORT": "medium",
    "PROCESSING_AUTHORITY": "cloudflare",
    "SELF_HOSTED_PROXY_ENABLED": "false",
    "EXPERIMENT_REPORT_EMAIL_FROM": "news@alerts.cartdotcom.com"
  },
  "send_email": [
    {
      "name": "EXPERIMENT_EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEWS_DB",
      "database_name": "cartdotcom-news-signal",
      "database_id": "8a3a5b15-c56a-4212-b8fe-38de91878b6a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTICLE_CORPUS",
      "bucket_name": "cartdotcom-news-article-corpus"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RESEARCH_QUEUE",
        "queue": "cartdotcom-news-signal-research"
      }
    ],
    "consumers": [
      {
        "queue": "cartdotcom-news-signal-research",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 8,
        "max_retries": 3
      }
    ]
  },
  "containers": [
    {
      "class_name": "CodexResearchContainer",
      "image": "./container/Dockerfile",
      "max_instances": 8
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CODEX_CONTAINER",
        "class_name": "CodexResearchContainer"
      },
      {
        "name": "DASHBOARD_EVENTS",
        "class_name": "DashboardEventHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodexResearchContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DashboardEventHub"]
    }
  ]
}
