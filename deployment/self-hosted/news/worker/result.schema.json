{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_title", "event_type", "event_blurb", "impact_details", "companies",
    "industries", "symbols", "sentiment_score", "impact_horizon", "confidence",
    "summary", "memo"
  ],
  "properties": {
    "event_title": { "type": "string" },
    "event_type": { "type": "string" },
    "event_blurb": { "type": "string" },
    "impact_details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "symbol", "direction", "confidence", "reason"],
        "properties": {
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "symbol": { "type": ["string", "null"] },
          "direction": { "enum": ["bullish", "bearish", "mixed", "neutral"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string" }
        }
      }
    },
    "companies": { "type": "array", "items": { "type": "string" } },
    "industries": { "type": "array", "items": { "type": "string" } },
    "symbols": { "type": "array", "items": { "type": "string" } },
    "sentiment_score": { "type": "number", "minimum": -1, "maximum": 1 },
    "impact_horizon": { "enum": ["immediate", "short", "medium", "long", "unknown"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string" },
    "memo": { "type": "string", "maxLength": 4000 }
  }
}
