FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN useradd --create-home --uid 1000 app
WORKDIR /app
COPY pyproject.toml ./
COPY app ./app
RUN pip install .
COPY migrations ./migrations
COPY static ./static
RUN mkdir -p /data/artifacts /work && chown -R app:app /data /work
USER app
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "3000"]
