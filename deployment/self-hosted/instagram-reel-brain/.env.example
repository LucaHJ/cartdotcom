# Phase 1 inert defaults. Copy to .env on the server only when required.
COMPOSE_PROJECT_NAME=cartdotcom-instagram-reel-brain
REEL_PHASE=phase1-inert
REEL_PROCESSING_AUTHORITY=cloud

REEL_INTAKE_ENABLED=false
REEL_DISPATCH_ENABLED=false
REEL_WORKER_ENABLED=false
REEL_CODEX_ENABLED=false
REEL_OUTBOUND_ENABLED=false
REEL_MUTATIONS_ENABLED=false
REEL_BACKLOG_ENABLED=false
REEL_PUBLISHER_ENABLED=false
REEL_ARCHIVER_ENABLED=false
REEL_AUTH_ROTATOR_ENABLED=false
REEL_PHASE5_RUNNER_ENABLED=false
REEL_WORKER_CONCURRENCY=1
REEL_MEDIA_PROCESSOR_ENABLED=false
REEL_MEDIA_FIXTURE_ONLY=true

REEL_DATA_ROOT=/srv/cartdotcom/reel-brain-data
REEL_RUNS_ROOT=/srv/cartdotcom/reel-brain-runs
REEL_BACKUP_ROOT=/srv/backups/instagram-reel-brain
REEL_TEST_STORAGE_ROOT=/srv/cartdotcom/reel-brain-runs/fixtures

# Phase 5 runner native PostgreSQL control path. Values are non-secret paths/names.
REEL_PHASE5_PG_MODE=native
REEL_PHASE5_PGHOST=cartdotcom-platform-postgres-1
REEL_PHASE5_PGPORT=5432
REEL_PHASE5_PGDATABASE=cartdotcom
REEL_PHASE5_PGUSER=cartdotcom
REEL_PHASE5_PG_PASSWORD_FILE=/run/secrets/postgres_password
REEL_PHASE5_ADMIN_TOKEN_FILE=/run/secrets/phase5_admin_token
